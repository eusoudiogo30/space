generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  name                String
  username            String?           @unique
  phone               String?
  document            String?
  email               String?           @unique
  passwordHash        String
  coinBalance         Int               @default(0)
  bestScore           Int               @default(0)
  isActive            Boolean           @default(true)
  isBlocked           Boolean           @default(false)
  isInfluencer        Boolean           @default(false)
  excludedFromRanking Boolean           @default(false)
  receivedSignupBonus Boolean           @default(false)
  referredByAffiliateId String?
  referredByAffiliate Affiliate?        @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  ownedAffiliate      Affiliate?        @relation("AffiliateOwner")
  lastLoginAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  games               Game[]
  transactions        CoinTransaction[]
  deposits            Deposit[]
  withdrawals         Withdrawal[]
  alerts              FraudAlert[]
  notes               UserNote[]

  @@index([createdAt])
  @@index([referredByAffiliateId])
}

model Affiliate {
  id               String                @id @default(cuid())
  userId           String                @unique
  user             User                  @relation("AffiliateOwner", fields: [userId], references: [id], onDelete: Cascade)
  code             String                @unique
  status           String                @default("ACTIVE")
  cpaAmount        Int                   @default(2000)
  cpaRtpMode       String                @default("GLOBAL")
  cpaRetentionEnabled Boolean            @default(true)
  cpaCycleSize     Int                   @default(10)
  cpaRetainedPositions String            @default("[9,10]")
  cpaEventCount    Int                   @default(0)
  availableBalance Int                   @default(0)
  withdrawnBalance Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  referrals        User[]                @relation("AffiliateReferrals")
  commissions      AffiliateCommission[]

  @@index([status, createdAt])
}

model AffiliateCommission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  userId      String
  depositId   String    @unique
  amount      Int
  position    Int       @default(1)
  status      String    @default("AVAILABLE")
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

model Game {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType        String             @default("SPACE_ADVENTURE")
  status          String             @default("ACTIVE")
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?
  score           Int                @default(0)
  stakeAmount     Int                @default(0)
  earlyExit       Boolean            @default(false)
  hits            Int                @default(0)
  misses          Int                @default(0)
  maxCombo        Int                @default(0)
  coinsRewarded   Int                @default(0)
  payoutMultiplier Float            @default(0)
  rtpPercentage  Float              @default(80)
  duration        Int                @default(30)
  riskLevel       String             @default("LOW")
  ip              String?
  userAgent       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  events          GameEvent[]
  transactions    CoinTransaction[]
  alerts          FraudAlert[]

  @@index([userId, finishedAt])
  @@index([status, finishedAt])
  @@index([gameType, finishedAt])
}

model GameEvent {
  id              String    @id @default(cuid())
  gameId          String
  game            Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  sequence        Int
  eventType       String
  targetId        String
  targetType      String
  holeIndex       Int
  clientTimestamp DateTime?
  serverTimestamp DateTime  @default(now())
  points          Int
  combo           Int
  metadata        String?

  @@unique([gameId, sequence])
  @@unique([gameId, targetId])
  @@index([gameId, serverTimestamp])
}

model Admin {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  passwordHash   String
  role           String            @default("ANALYST")
  isActive       Boolean           @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]
  transactions   CoinTransaction[]
  reviewedAlerts FraudAlert[]      @relation("FraudReviewer")
  notes          UserNote[]
  rtpSettings    RtpSetting[]
}

model RtpSetting {
  id         String   @id @default(cuid())
  percentage Float    @default(80)
  enabled    Boolean  @default(true)
  isActive   Boolean  @default(true)
  reason     String
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([isActive, createdAt])
}

model PaymentGatewaySetting {
  id                    String   @id @default("ZYPHER")
  enabled               Boolean  @default(false)
  baseUrl               String   @default("https://api.zypher.global")
  clientId              String?
  clientSecretEncrypted String?
  webhookUrl            String?
  webhookTokenEncrypted String?
  timeoutMs             Int      @default(10000)
  splitUsername         String?  @default("mildff")
  splitPercentage       Int      @default(5)
  updatedAt             DateTime @updatedAt
}

model Deposit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  status      String   @default("CONFIRMED")
  provider    String   @default("DEMO")
  reference   String   @unique
  providerTransactionId String?
  qrImage     String?
  copyPaste   String?
  endToEndId  String?
  createdAt   DateTime @default(now())
  confirmedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int
  feeAmount   Int      @default(0)
  status      String   @default("COMPLETED")
  provider    String   @default("DEMO")
  reference   String   @unique
  providerTransactionId String?
  endToEndId  String?
  destinationType String?
  destinationLast4 String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PlatformSetting {
  id                    String   @id @default("MAIN")
  minimumBet            Int      @default(500)
  maximumBet            Int      @default(25000)
  suggestedBets         String   @default("[5,10,20,50,100,200,250]")
  minimumDeposit        Int      @default(1000)
  maximumDeposit        Int      @default(1000000)
  minimumWithdrawal     Int      @default(5000)
  maximumWithdrawal     Int      @default(1000000)
  withdrawalFeePercentage Float  @default(0)
  signupBonusEnabled    Boolean  @default(false)
  signupBonusAmount     Int      @default(0)
  registrationsEnabled  Boolean  @default(true)
  depositsEnabled       Boolean  @default(true)
  withdrawalsEnabled    Boolean  @default(true)
  maintenanceMode       Boolean  @default(false)
  affiliateDefaultCpaAmount Int  @default(2000)
  affiliateCpaRetentionEnabled Boolean @default(false)
  affiliateCpaCycleSize Int     @default(10)
  affiliateCpaRetainedPositions String @default("[9,10]")
  updatedAt             DateTime @updatedAt
}

model SpaceDifficultySetting {
  id             String   @id @default("MAIN")
  freePlayEnabled Boolean @default(true)
  preset         String   @default("medium")
  minFallMs      Int      @default(950)
  maxFallMs      Int      @default(1650)
  spawnGapMs     Int      @default(620)
  rampWindowMs   Int      @default(60000)
  rockFrequency  Int      @default(42)
  coinFrequency  Int      @default(46)
  boostFrequency Int      @default(12)
  boostDurationMs Int     @default(3000)
  maximumScore   Int      @default(10000)
  hitRadius      Float    @default(0.11)
  hitRadiusY     Float    @default(0.08)
  freeRtpPercentage Float @default(80)
  shipSpeed      Float    @default(1.35)
  multiplierPerFloor Float @default(0.03)
  gemUpgradeChance Float  @default(0.15)
  gemComboValue Int       @default(3)
  boostRockFrequency Int  @default(42)
  updatedAt      DateTime @updatedAt
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model AdminSession {
  id               String    @id @default(cuid())
  adminId          String
  admin            Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([adminId, expiresAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String?
  admin        Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  resourceId   String?
  previousData String?  @db.Text
  newData      String?  @db.Text
  reason       String?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model CoinTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId        String?
  game          Game?    @relation(fields: [gameId], references: [id])
  adminId       String?
  admin         Admin?   @relation(fields: [adminId], references: [id])
  type          String
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reason        String
  createdAt     DateTime @default(now())

  @@unique([gameId, type])
  @@index([userId, createdAt])
}

model FraudAlert {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId            String?
  game              Game?     @relation(fields: [gameId], references: [id])
  type              String
  description       String
  evidence          String?
  riskLevel         String
  status            String    @default("OPEN")
  reviewedByAdminId String?
  reviewedBy        Admin?    @relation("FraudReviewer", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([status, riskLevel, createdAt])
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id])
  content   String
  createdAt DateTime @default(now())
}
